# Copy to .env for local development. Do not commit a filled-in .env.
#
# When deployed, LAKEBASE_URL is resolved at runtime from the Databricks
# secret scope named in app.yaml - the value never appears in source control.

LAKEBASE_URL=postgresql://<role>:<password>@<host>.database.<region>.cloud.databricks.com:5432/databricks_postgres?sslmode=require

# The NWS API rejects requests without a descriptive User-Agent identifying
# the application and a contact address. This is a documented requirement of
# api.weather.gov, not an optional nicety.
NWS_USER_AGENT=(SkyIndex-AI, lubobali23@gmail.com)
NWS_API_BASE_URL=https://api.weather.gov

# Outbound request pacing, in requests per second, against api.weather.gov.
NWS_MAX_REQUESTS_PER_SECOND=4

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Databricks Foundation Model serving endpoint used for the RAG summary.
# Optional: when unset or unreachable, search still returns ranked results.
SUMMARY_ENDPOINT=databricks-meta-llama-3-3-70b-instruct
